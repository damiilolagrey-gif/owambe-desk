# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Random value that must match private.settings.server_secret in the database
SERVER_SECRET=

# Paystack dashboard > Settings > API Keys (use sk_test_ until you go live)
PAYSTACK_SECRET_KEY=sk_test_xxx

# Public URL of the app, used for Paystack's return link
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: WhatsApp Business Cloud API alerts. Leave empty to only post in the app chat.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=payment_update
